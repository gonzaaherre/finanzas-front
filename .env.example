# Base URL used by the axios client (src/api/client.js).
# In dev, "/api" works as-is because the Vite dev server proxies it (see below).
# In production, point this at the deployed backend, e.g. https://api.midominio.com/api
VITE_API_URL=/api

# Target for the Vite dev server's /api proxy (vite.config.js). Only used in dev.
VITE_BACKEND_URL=http://localhost:8080
